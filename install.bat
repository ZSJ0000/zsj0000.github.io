@echo off
setlocal
chcp 65001 >nul
cd /d "%~dp0"
set "INSTALL_FILE=install"
set "INSTALL_"
if exist "%INSTALL_FILE%" del /f /q "%INSTALL_FILE%" >nul 2>&1
echo 正在离线创建 install 文件...
>"%INSTALL_FILE%.b64" echo %INSTALL_B64%
certutil -decode "%INSTALL_FILE%.b64" "%INSTALL_FILE%" >nul 2>&1
del /f /q "%INSTALL_FILE%.b64" >nul 2>&1
if not exist "%INSTALL_FILE%" (
 echo 创建 install 文件失败。
 pause
 exit /b 1
)
echo 正在运行离线 install...
python "%INSTALL_FILE%"
set "INSTALL_RESULT=%errorlevel%"
echo 正在删除 install 文件...
del /f /q "%INSTALL_FILE%" >nul 2>&1
if exist "%INSTALL_FILE%" echo 警告：install 文件删除失败，请手动删除。
if not "%INSTALL_RESULT%"=="0" (
 echo 离线安装失败，退出码：%INSTALL_RESULT%
 pause
 exit /b %INSTALL_RESULT%
)
echo 离线安装完成。
pause
exit /b 0
